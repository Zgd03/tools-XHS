<Window x:Class="DarenTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="达人 Excel 工具 · 2.0.2 优化开发版" Width="1080" Height="790" MinWidth="900" MinHeight="680" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="FileDrop" Closing="WindowClosing">
  <Grid Margin="30,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="达人 Excel 工具" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="整理发布链接，更新投放数据。结果另存，原表保留。" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><TextBlock Text="2.0.2 · 待实测" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource Muted}"/></DockPanel>
    <Grid Grid.Row="1" x:Name="Inputs">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Excel 文件" Margin="0,0,0,7"/>
      <TextBox x:Name="SourceBox" Grid.Row="1" ToolTip="选择或拖入 .xlsx 工作簿"/><Button Grid.Row="1" Grid.Column="1" Content="选择文件…" Click="ChooseSource" Margin="10,0,0,0"/>
      <TextBlock Grid.Row="2" Text="结果保存到" Margin="0,15,0,7"/>
      <TextBox Grid.Row="3" x:Name="OutputBox"/><Button Grid.Row="3" Grid.Column="1" Content="选择目录…" Click="ChooseOutput" Margin="10,0,0,0"/>
      <TextBlock Grid.Row="4" Text="处理功能" Margin="0,15,0,7"/>
      <ComboBox Grid.Row="5" x:Name="ModeBox" SelectedIndex="0" SelectionChanged="ModeChanged"><ComboBoxItem Content="更新五项数据"/><ComboBoxItem Content="只更新点赞、收藏、评论"/><ComboBoxItem Content="发布长链接转短链接"/><ComboBoxItem Content="转短链并更新五项数据"/></ComboBox>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,18,0,18">
      <WrapPanel x:Name="LoginControls"><Button Content="小红书登录" Click="LoginXhs"/><Button Content="蒲公英登录 / 选择品牌" Click="LoginPgy"/><Button Content="读取当前品牌" Click="DetectBrand"/></WrapPanel>
      <TextBlock x:Name="BrandText" Text="蒲公英：尚未读取。五项模式请先登录、选择品牌并查询。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0"/>
      <TextBlock x:Name="ModeHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
      <CheckBox x:Name="ResumeCheck" Content="继续上次采集（同一源文件、同一模式，一小时内的互动数据）" Margin="0,9,0,0"/>
    </StackPanel>
    <DockPanel Grid.Row="3" Margin="0,0,0,12"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="StartButton" Content="开始处理" Click="StartRun" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}" FontWeight="SemiBold"/><Button x:Name="CancelButton" Content="取消处理" Click="CancelRun" IsEnabled="False"/><Button x:Name="ResultsButton" Content="打开本次结果" Click="OpenResults" IsEnabled="False" Margin="0"/></StackPanel><TextBlock x:Name="StatusText" Text="请选择文件" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/></DockPanel>
    <ProgressBar Grid.Row="4" x:Name="Progress" Height="4" Margin="0,0,0,12" Foreground="{StaticResource Accent}"/>
    <TabControl Grid.Row="5"><TabItem Header="处理明细"><DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" Background="White" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="行" Binding="{Binding Row}" Width="45"/><DataGridTextColumn Header="达人" Binding="{Binding Name}" Width="120"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="本次写入" Binding="{Binding Values}" Width="210"/><DataGridTextColumn Header="原因 / 提示" Binding="{Binding Reason}" Width="*" MinWidth="180"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="运行日志"><TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem></TabControl>
    <DockPanel Grid.Row="6" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="清理网页缓存" Click="ClearBrowserCache" FontSize="12" Padding="8,4" MinHeight="28" Margin="10,0,0,0"/><TextBlock Text="使用“达人数据更新”工作表；未获取的指标保留原值。登录和缓存仅保存在当前 Windows 用户目录。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
  </Grid>
</Window>
